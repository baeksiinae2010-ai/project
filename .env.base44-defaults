# Local development defaults (committed, no real credentials).
# Read FIRST by the app services; /run/base44/app.env is read LAST so real
# dashboard secrets always win.
#
# Points the app at the local Supabase-compatible REST API from
# docker-compose.base44.yml instead of a hosted Supabase project.
SUPABASE_URL=http://rest-proxy

# Shared by PostgREST (verifies) and the dev anon JWT the app signs at startup.
PGRST_JWT_SECRET=base44-local-postgrest-jwt-secret-0123456789
